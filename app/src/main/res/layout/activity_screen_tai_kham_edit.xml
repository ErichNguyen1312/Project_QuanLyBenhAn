<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <include layout="@layout/custom_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Ngày tái khám -->
            <TextView
                android:text="Ngày tái khám"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNgayTaiKham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border"
                android:padding="12dp"
                android:text="Chọn ngày"
                android:textColor="#888888"
                android:clickable="true"
                android:focusable="true" />

            <!-- Giờ tái khám -->
            <TextView
                android:text="Giờ tái khám"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvGioTaiKham"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border"
                android:padding="12dp"
                android:text="Chọn giờ"
                android:textColor="#888888"
                android:clickable="true"
                android:focusable="true" />

            <!-- Ghi chú -->
            <TextView
                android:text="Ghi chú"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border"
                android:padding="12dp"
                android:minLines="3"
                android:gravity="top"
                android:hint="Nhập ghi chú" />

            <!-- Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_marginTop="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lưu lịch tái khám" />
            <Button
                android:id="@+id/btnXoa"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xóa lịch tái khám" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
