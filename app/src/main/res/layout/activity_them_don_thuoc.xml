<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#DBF2FF"
    tools:context=".ui.DonThuocUI.ThemDonThuoc">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5ABAF3"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iconBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thêm Đơn Thuốc"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm đơn thuốc mới"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/edtMaBenhNhan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Mã bệnh nhân (ID Hồ sơ)"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="number"
                android:textColorHint="#A0A0A0"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F5F5F5" />

            <EditText
                android:id="@+id/edtTenBenhNhan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Tên bệnh nhân"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="textCapWords"
                android:textColorHint="#A0A0A0"
                android:background="@android:drawable/edit_text"
                android:backgroundTint="#F5F5F5" />

            <EditText
                android:id="@+id/edtTenThuoc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Tên thuốc"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="textCapSentences"
                android:textColorHint="#A0A0A0" />

            <EditText
                android:id="@+id/edtDangThuoc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Dạng thuốc"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="textCapSentences"
                android:textColorHint="#A0A0A0" />

            <EditText
                android:id="@+id/edtLieuDung"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Liều dùng"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:textColorHint="#A0A0A0" />

            <EditText
                android:id="@+id/edtSoLanDung"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Số lần dùng trong ngày"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"
                android:inputType="number"
                android:textColorHint="#A0A0A0" />

            <EditText
                android:id="@+id/edtGhiChu"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Ghi chú"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:layout_marginBottom="32dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:textColorHint="#A0A0A0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnLuu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lưu"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginEnd="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btnXoa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hủy"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#F44336"
                    android:layout_marginStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>